{
  "manifest_version": 3,
  "name": "JobSort",
  "version": "1.0",
  "description": "One-click save jobs from LinkedIn, Indeed, Glassdoor, Monster, ZipRecruiter, Dice, SimplyHired, Wellfound, and CareerBuilder to your JobSort board.",
  "permissions": ["storage", "identity"],
  "host_permissions": [
    "https://*.linkedin.com/*",
    "https://*.indeed.com/*",
    "https://*.glassdoor.com/*",
    "https://*.monster.com/*",
    "https://*.ziprecruiter.com/*",
    "https://*.dice.com/*",
    "https://*.simplyhired.com/*",
    "https://*.wellfound.com/*",
    "https://*.careerbuilder.com/*",
    "http://localhost:8000/*"
  ],
  "background": {
    "service_worker": "background.js"
  },
  "content_scripts": [
    {
      "matches": [
        "https://*.linkedin.com/jobs/view/*",
        "https://*.linkedin.com/jobs/collections/*",
        "https://*.indeed.com/viewjob*",
        "https://*.indeed.com/*/jobs/*",
        "https://*.indeed.com/job/*",
        "https://*.indeed.com/*job*",
        "https://*.indeed.com/pagead/*",
        "https://*.glassdoor.com/job-listing/*",
        "https://*.glassdoor.com/Job/*",
        "https://*.glassdoor.com/*/job-listing/*",
        "https://*.monster.com/job-openings/*",
        "https://*.monster.com/jobs/*",
        "https://*.monster.com/*/job-openings/*",
        "https://*.ziprecruiter.com/jobs/*",
        "https://*.ziprecruiter.com/job/*",
        "https://*.dice.com/job-detail/*",
        "https://*.dice.com/jobs/detail/*",
        "https://*.simplyhired.com/job/*",
        "https://*.simplyhired.com/search*",
        "https://*.wellfound.com/jobs/*",
        "https://*.wellfound.com/companies/*/jobs/*",
        "https://*.careerbuilder.com/job/*",
        "https://*.careerbuilder.com/*/job/*"
      ],
      "js": ["utils/scrapers.js", "content.js"],
      "run_at": "document_idle"
    }
  ],
  "action": {
    "default_popup": "popup.html",
    "default_icon": {
      "16": "icons/icon16.png",
      "48": "icons/icon48.png",
      "128": "icons/icon128.png"
    }
  },
  "icons": {
    "16": "icons/icon16.png",
    "48": "icons/icon48.png",
    "128": "icons/icon128.png"
  }
}
